#!/bin/sh
# fetch-engine — POSIX launcher: resolve a python>=3.11 with tomllib, exec engine.
# Never trust bare `env python3` in stripped-PATH contexts (mac /usr/bin/python3
# is Apple CLT 3.9.6 without tomllib — demonstrated trap).
SELF="$0"
while [ -h "$SELF" ]; do
  _d=$(CDPATH='' cd -P "$(dirname "$SELF")" && pwd)
  SELF=$(readlink "$SELF")
  case "$SELF" in /*) ;; *) SELF="$_d/$SELF" ;; esac
done
DIR=$(CDPATH='' cd -P "$(dirname "$SELF")" && pwd)
ENGINE="$DIR/fetch_engine.py"

_pyok() {
  [ "$("$1" -c 'import sys,tomllib;print("ok" if sys.version_info>=(3,11) else "")' 2>/dev/null)" = "ok" ]
}

if [ -n "$FETCH_ENGINE_PYTHON" ] && _pyok "$FETCH_ENGINE_PYTHON"; then
  exec "$FETCH_ENGINE_PYTHON" "$ENGINE" "$@"
fi

for _p in python3 python3.14 python3.13 python3.12 python3.11; do
  if command -v "$_p" >/dev/null 2>&1; then
    _b=$(command -v "$_p")
    if _pyok "$_b"; then exec "$_b" "$ENGINE" "$@"; fi
  fi
done

case "$(uname -s 2>/dev/null)" in
Darwin) _c=/opt/homebrew/bin/python3 ;;
*) _c=/usr/bin/python3 ;;
esac
if [ -x "$_c" ] && _pyok "$_c"; then exec "$_c" "$ENGINE" "$@"; fi

for _g in "$HOME"/.local/share/uv/python/cpython-3.1*/bin/python3 \
  "$HOME"/.local/share/uv/python/cpython-3.2*/bin/python3; do
  if [ -x "$_g" ] && _pyok "$_g"; then exec "$_g" "$ENGINE" "$@"; fi
done

echo "fetch-engine: no python>=3.11 with tomllib found" >&2
echo "  set FETCH_ENGINE_PYTHON=/path/to/python3" >&2
exit 127
