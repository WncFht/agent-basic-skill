def _main():
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    ap.add_argument(
        "url", nargs="?", help="课程页 URL / 课程 ID / play-center 分享链接"
    )
    ap.add_argument("-o", "--out", default=".")
    ap.add_argument("--lecture", type=int, help="第 N 讲（按上课时间排序）")
    ap.add_argument("--all", action="store_true", help="下载全部讲次")
    ap.add_argument(
        "--camera",
        default="auto",
        help="auto(默认，优先 PPT 录屏) | all | 机位序号 N",
    )
    ap.add_argument(
        "--cover-at",
        default="120",
        metavar="SEC|MM:SS",
        help="封面抽帧时刻（默认 120s；课前常为签到/待机画面，建议取第一页标题 slide 时段）",
    )
    ap.add_argument(
        "--token",
        help="Canvas PAT（默认 $CANVAS_TOKEN 或 ~/.config/canvas-skill/token）",
    )
    ap.add_argument("--list-courses", action="store_true", help="列我在选的课")
    ap.add_argument("--files", action="store_true", help="列/下载课程文件")
    ap.add_argument("--download", metavar="DIR", help="配合 --files 下载到目录")
    ap.add_argument("--announcements", action="store_true", help="列课程公告")
    ap.add_argument("--assignments", action="store_true", help="列作业与截止时间")
    ap.add_argument(
        "--mint",
        action="store_true",
        help="为课程铸 LTI jwt/tecl 凭证键（cred store 预生产）",
    )
    ap.add_argument(
        "--refresh",
        action="store_true",
        help="跳过全部缓存读（正/负/车道级），成功仍写回",
    )
    ap.add_argument("--no-cache", action="store_true", help="读写全绕缓存 = 裸行为")
    ap.add_argument(
        "--cache-ttl",
        type=int,
        default=None,
        metavar="SEC",
        help="覆盖本次正缓存 TTL（不作用负缓存）",
    )
    args = ap.parse_args()
    if args.refresh:
        os.environ["LGC_REFRESH"] = "1"
    if args.no_cache:
        os.environ["LGC_OFF"] = "1"
    if args.cache_ttl is not None:
        os.environ["LGC_TTL"] = str(args.cache_ttl)

    if not args.url and not args.list_courses:
        ap.error("需要课程页 URL / 课程 ID，或 --list-courses")

    cam = args.camera
    if cam not in ("auto", "all") and not cam.isdigit():
        die(f"--camera {cam} 无效（auto|all|机位序号 N）", 2)

    # play-center 链接纯本地解密，失败立刻报
    play_tecl = None
    if args.url and ("v.sjtu.edu.cn" in args.url or "play-center" in args.url):
        play_tecl = play_tecl_id(args.url)
        if not play_tecl:
            die("play-center 参数解密失败：链接不完整或前端密钥已轮换", 2)

    sess = Session(load_token(args.token))
    tk = tok8(sess)

    if args.list_courses:
        cmd_list_courses(sess)
        return

    if play_tecl and (
        args.files or args.announcements or args.assignments or args.mint
    ):
        die(
            "play-center 链接只支持实录列表/下载；课程资源子命令请改用 "
            "oc.sjtu.edu.cn 课程页 URL",
            2,
        )

    course_id = None if play_tecl else resolve_course_id(args.url)

    # 轻量资源子命令：REST API 直走，不做 LTI launch
    if args.files:
        cmd_files(sess, course_id, args.download)
        return
    if args.announcements:
        cmd_announcements(sess, course_id)
        return
    if args.assignments:
        cmd_assignments(sess, course_id)
        return
    if args.mint:
        cmd_mint(sess, course_id)
        return

    out = Path(args.out)
    try:
        out.mkdir(parents=True, exist_ok=True)
    except OSError as e:
        die(f"无法创建输出目录：{e}", 5)

    # --- 讲次列表：lec-list 15min 仅服务展示；--lecture/--all 恒实时拉 ---
    # 展示路径先拿 tecl 探快照（play 链接本地已知；课程路径 probe tecl 缓存），
    # 命中即展示——不为一次缓存命中白做 LTI launch。
    live = bool(args.lecture or args.all)
    lectures = None
    lec_list_key = None
    if not live:
        if play_tecl:
            pre_tecl = play_tecl
        else:
            rc, t = cache_cat(f"tecl:{tk}:{course_id}", tk)
            pre_tecl = t.strip() if rc == 0 else None
        if pre_tecl:
            lec_list_key = f"lec-list:{tk}:{pre_tecl}"
            rc, snap = cache_cat(lec_list_key, tk)
            if rc == 0:
                try:
                    lectures = json.loads(snap)
                except ValueError:
                    lectures = None

    box = None
    tecl_id = None
    if lectures is None:
        # --- LTI 鉴权（jwt/tecl/donor 三层 value 缓存） ---
        if play_tecl:
            jwt, donor_cid = donor_token(sess)
            tecl_id = play_tecl
            box = {"jwt": jwt, "course_id": donor_cid, "tecl": tecl_id}

            def _relaunch_donor():
                cache_clear(f"jwt:{tk}:{box['course_id']}", tk)
                j, c = donor_token(sess)
                box["course_id"] = c
                return j

            box["relaunch"] = _relaunch_donor
            log(f"play-center 链接 -> 教学班 teclId={tecl_id}")
        else:
            try:
                jwt, tecl_id = lti_launch(sess, course_id)
            except Exception as e:  # LtiError 或网络层失败 → 车道全挂 5
                die(str(e), 5)
            box = {"jwt": jwt, "course_id": course_id, "tecl": tecl_id}

            def _relaunch_course():
                # 缓存 jwt 被下游判死：evict 该键再经缓存层重 launch 一次
                cache_clear(f"jwt:{tk}:{course_id}", tk)
                j, t = lti_launch(sess, course_id)
                box["tecl"] = t
                return j

            box["relaunch"] = _relaunch_course

        lec_list_key = f"lec-list:{tk}:{tecl_id}"
        try:
            lectures = list_lectures(sess, box, tecl_id)
        except urllib.error.HTTPError as e:
            die(f"实录列表拉取失败：HTTP {e.code}", 5)
        except Exception as e:  # LtiError 或网络层失败 → 车道全挂 5
            die(str(e), 5)
        if lectures:
            rc, snap = cache_cat(lec_list_key, tk)
            try:
                old = json.loads(snap) if rc == 0 else None
            except ValueError:
                old = None
            if live and old is not None and _lec_sig(old) != _lec_sig(lectures):
                log("警告：讲次列表已变化——此前展示的列表快照已陈旧，序号可能偏移")
            cache_vput(lec_list_key, json.dumps(lectures, ensure_ascii=False), tk)
    if not lectures:
        die("该课程暂无已生成点播的实录", 3)

    if not args.lecture and not args.all:
        # cour_id 打进列表：可与本地 canvas/<cour_id>--* 目录机械比对增量。
        # 扫 --out 本身、--out 同级、cwd 与 cwd/canvas 四处已有目录；
        # lgc lec:* 束另打 [已缓存]（用户删了 -o 也能秒回）。
        local = set()
        for base in (out, out.parent, Path.cwd(), Path.cwd() / "canvas"):
            if base.is_dir():
                local |= {p.name.split("--")[0] for p in base.glob("*--*")}
        cached = {
            m.group(1)
            for k in cache_list("lec:*")
            for m in [re.match(r"lec:([^#]+)", k)]
            if m
        }
        for i, r in enumerate(lectures, 1):
            cid = str(r.get("id") or r.get("courId") or "")
            if cid and cid in local:
                mark = "  [已下载]"
            elif cid and cid in cached:
                mark = "  [已缓存]"
            else:
                mark = ""
            # vodClickEnable 缺省不判；显式 0 多半还在转码/未发布
            if r.get("vodClickEnable") in (0, "0", False):
                mark += "  [不可点播？]"
            print(f"{i:2d}. [cour_id={cid}] {lecture_title(r, i)}{mark}")
        print("\n用 --lecture N 选择一讲，--all 下载全部", file=sys.stderr)
        return

    picked = range(1, len(lectures) + 1) if args.all else [args.lecture]
    done = 0
    for idx in picked:
        if not (1 <= idx <= len(lectures)):
            die(f"--lecture {idx} 超出范围（共 {len(lectures)} 讲）", 2)
        rec = lectures[idx - 1]
        title = lecture_title(rec, idx)
        cour_id = str(rec.get("id") or rec.get("courId") or "")
        log(f"[{idx}/{len(lectures)}] {title}")
        unlisted = rec.get("vodClickEnable") in (0, "0", False)
        if unlisted:
            log("  警告：该讲标记为不可点播（可能仍在转码），仍尝试拉流…")
        # --all 每讲独立 <cour_id>--<slug>/ 子目录（修同目录同名互覆）；
        # --lecture 保持平铺进 -o。
        lec_dir = out / f"{cour_id}--{_slug(title)}" if args.all else out
        lec_key = f"lec:{cour_id}"
        try:
            # probe 顺序钉死 jwt→src→lec：src 解析 viewNum 供 satisfies
            sources = get_sources(sess, box, cour_id, tk)
            if not sources:
                log("  无可用播流，跳过")
                continue
            lec_dir.mkdir(parents=True, exist_ok=True)  # 有源才建（--all 不留空壳）
            n = int(cam) if cam.isdigit() else None
            if cam == "all":
                satisfies = {"camera": "all"}
            else:
                if cam == "auto":
                    pick = next(
                        (s for s in sources if s["kind"] == "screen"), sources[0]
                    )
                else:
                    if not (1 <= n <= len(sources)):
                        die(f"--camera {n} 超出范围（共 {len(sources)} 个源）", 2)
                    pick = sources[n - 1]
                # auto/N 统一解析成具体机位 tag：auto 不再抽象匹配"任一 screen"，
                # N 在 viewNum 缺席时退位置序——束语义与命名同口径
                satisfies = {"camera": _view_tag(sources, pick)}

            rc, info = cache_get_lec(lec_key, lec_dir, satisfies, tk)
            if rc == 0 and info:
                # 命中：回放产物；cover_at 不符→缓存 video 就地重抽；
                # 缺 audio.wav→就地重抽（D7）。
                names = {f.get("name") for f in info.get("files") or []}
                mparams = info.get("params") or {}
                want_name = None
                if cam != "all":
                    # 束可能产自 --camera all 全机位入库：materialize 已交付
                    # 整束，只留本次挑中机位的 mp4（fv 缺席=不可证，保守留）
                    want = {
                        _view_tag(sources, s) for s in pick_sources(sources, cam, n)
                    }
                    for f in info.get("files") or []:
                        fn = f.get("name") or ""
                        fv = f.get("viewNum")
                        if fn.endswith(".mp4") and fv is not None and fv not in want:
                            (lec_dir / fn).unlink(missing_ok=True)
                            names.discard(fn)
                    want_name = next(
                        (
                            f.get("name")
                            for f in info.get("files") or []
                            if f.get("viewNum") in want
                            and (f.get("name") or "") in names
                        ),
                        None,
                    )
                vname = want_name or mparams.get("cover_source")
                if not vname or vname not in names:
                    vname = next((x for x in sorted(names) if x.endswith(".mp4")), None)
                if vname:
                    vpath = lec_dir / vname
                    if (
                        str(mparams.get("cover_at")) != str(args.cover_at)
                        or not (lec_dir / "cover.jpg").is_file()
                    ):
                        extract_cover(vpath, lec_dir / "cover.jpg", args.cover_at)
                    if not (lec_dir / "audio.wav").is_file():
                        extract_audio(vpath, lec_dir / "audio.wav")
                for p in info.get("paths") or []:
                    print(f"==> 已存 {p}（cache）", file=sys.stderr)
                log(f"完成 -> {lec_dir}（缓存命中）")
                done += 1
                continue

            # miss → 实时抓取；产物先落盘交付，再入库（lgc 不在交付路径）
            chosen = pick_sources(sources, cam, n)
            saved = []
            multi = len(chosen) > 1
            retried = False
            j = 0
            while j < len(chosen):
                s = chosen[j]
                name = (
                    f"camera{_view_tag(sources, s)}.mp4"
                    if (multi or cam != "auto")
                    else "video.mp4"
                )
                dest = lec_dir / name
                try:
                    download(sess, s["url"], dest)
                except urllib.error.HTTPError as e:
                    if e.code == 403 and not retried:
                        # 播流签名 URL 过期：evict src + 实时重拉一次
                        retried = True
                        log("  播流 URL 403（签名过期）→ 重拉 sources 重试")
                        cache_clear(f"src:{tk}:{cour_id}", tk)
                        fresh = vod_sources(sess, box, cour_id)
                        if fresh:
                            cache_vput(f"src:{tk}:{cour_id}", json.dumps(fresh), tk)
                            sources = fresh  # tag/meta 口径随新源
                            chosen = pick_sources(fresh, cam, n)
                        if j >= len(chosen):
                            raise
                        continue
                    raise
                saved.append((dest, s))
                j += 1

            video = next((p for p, _ in saved if p.name == "video.mp4"), saved[0][0])
            if not has_audio(video):
                alt = next((p for p, _ in saved if has_audio(p)), None)
                if alt:
                    video = alt
                else:
                    log("  警告：所下载源均无音轨")
            extract_audio(video, lec_dir / "audio.wav")
            extract_cover(video, lec_dir / "cover.jpg", args.cover_at)
            (lec_dir / "meta.json").write_text(
                json.dumps(
                    {
                        "platform": "sjtu-canvas",
                        "course_id": course_id,
                        "tecl_id": tecl_id,
                        "lecture_index": idx,
                        "cour_id": cour_id,
                        "title": title,
                        "begin": rec.get("courBeginTime"),
                        "end": rec.get("courEndTime"),
                        "sources": [
                            {"viewNum": s["viewNum"], "kind": s["kind"]}
                            for s in sources
                        ],
                        "lectures": [
                            {"index": i, "title": lecture_title(r, i)}
                            for i, r in enumerate(lectures, 1)
                        ],
                    },
                    ensure_ascii=False,
                    indent=2,
                ),
                encoding="utf-8",
            )
            # 入库判定：vodClickEnable==0 或 video<1MB 拒收（不缓存仍可交付）
            bundle = [p for p, _ in saved]
            for extra in ("audio.wav", "cover.jpg", "meta.json"):
                p = lec_dir / extra
                if p.is_file() and p.stat().st_size > 0:
                    bundle.append(p)
            vsize = video.stat().st_size if video.is_file() else 0
            if unlisted or vsize < (1 << 20):
                log("  跳过入库（不可点播或视频体积异常）")
            else:
                fmeta = {
                    p.name: {"viewNum": _view_tag(sources, s), "kind": s.get("kind")}
                    for p, s in saved
                }
                cache_put_lec(
                    lec_key,
                    bundle,
                    tk,
                    {
                        "has_all": cam == "all",
                        "cover_at": str(args.cover_at),
                        "cover_source": video.name,
                        "files_meta": fmeta,
                    },
                )
        except Exception as e:
            die(f"下载失败：{e}", 5)
        finally:
            cache_release(lec_key, tk)
        log(f"完成 -> {lec_dir}（audio.wav 已备好，跑 asr transcribe.py 转写）")
        done += 1
    if args.lecture and done == 0:
        die(f"第 {args.lecture} 讲未交付（无可用播流或下载失败）", 5)


def main():
    """网络层异常兜底 + 最后保险：干净 stderr 一行 + exit 5，绝不吐 traceback。
    捕获顺序钉死：HTTPError 是 URLError 子类必须在前；OSError 兜住
    socket.timeout/连接重置/TLS 等 read 期异常；HTTPException 兜协议错；
    Exception 兜底穿透分层的未预期错（如错形 JSON 元素上的 AttributeError）。
    SystemExit(die)/KeyboardInterrupt 非 Exception 子类，天然穿透不被吞。"""
    try:
        _main()
    except urllib.error.HTTPError as e:
        die(f"HTTP {e.code} {getattr(e, 'url', '')}", 5)
    except urllib.error.URLError as e:
        die(f"网络错误：{getattr(e, 'reason', e)}", 5)
    except (OSError, HTTPException) as e:
        die(f"网络/IO 错误：{e}", 5)
    except Exception as e:
        die(f"内部错误 {type(e).__name__}：{e}", 5)


if __name__ == "__main__":
    main()
