def list_lectures(sess, box, tecl_id):
    payload = jwt_api_get(
        sess,
        box,
        "/v1/subject_vod_list_new",
        **{
            "page.pageIndex": 1,
            "page.pageSize": 1000,
            "teclIds": tecl_id,
            "page.orders[0].asc": "true",
            "page.orders[0].field": "courBeginTime",
        },
    )
    records = (payload.get("data") or {}).get("records") or []
    return [r for r in records if r.get("vodEnable") in (None, 1)]


def _lec_sig(records):
    """讲次列表签名：lec-list 展示快照 vs 实时列表的漂移判据。"""
    return [
        [
            str(r.get("id") or r.get("courId") or ""),
            str(r.get("subjName") or r.get("courName") or ""),
            str(r.get("courBeginTime") or ""),
        ]
        for r in records
    ]


def lecture_title(rec, index):
    name = rec.get("subjName") or rec.get("courName") or "lecture"
    week = rec.get("week") or rec.get("weekNumber") or rec.get("weekNo")
    begin = str(rec.get("courBeginTime") or "")
    end = str(rec.get("courEndTime") or "")
    span = f"{begin[:16]}-{end[11:16] if len(end) >= 16 else end}".strip("-")
    return (
        " ".join(p for p in (name, f"第{week}周" if week else "", span) if p)
        or f"lecture-{index:02d}"
    )


def _slug(text):
    """--all 子目录名：<cour_id>--<slug>（保 CJK，剥路径敌意字符）。"""
    s = re.sub(r"[^\w.-]+", "-", text).strip("-.")
    s = re.sub(r"-{2,}", "-", s)
    return s[:60].rstrip("-.") or "lec"


def vod_sources(sess, box, cour_id):
    payload = jwt_api_get(sess, box, "/v1/course_vod_urls_new", courseId=cour_id)
    detail = payload.get("data") or payload.get("body") or {}
    out, seen = [], set()
    for item in detail.get("courseVodViewList") or []:
        url = item.get("url") or ""
        if not url.startswith("http"):
            continue
        path = urllib.parse.urlparse(url).path
        if path in seen:
            continue
        seen.add(path)
        vn = item.get("viewNum")
        try:
            vn = int(vn)
        except (TypeError, ValueError):
            vn = None
        out.append(
            {
                "url": url,
                "viewNum": vn,
                "kind": "screen" if vn in SCREEN_VIEW_NUMS else "classroom",
            }
        )
    return out


def get_sources(sess, box, cour_id, tk):
    """src:<tok8>:<cour> 10min value 缓存（probe 顺序 jwt→src→lec）。"""
    key = f"src:{tk}:{cour_id}"
    rc, val = cache_cat(key, tk)
    if rc == 0:
        try:
            cached = json.loads(val)
            if isinstance(cached, list) and cached:
                return cached
        except ValueError:
            pass
    sources = vod_sources(sess, box, cour_id)
    if sources:
        cache_vput(key, json.dumps(sources), tk)
    return sources


def pick_sources(sources, cam, n):
    if cam == "all":
        return list(sources)
    if cam != "auto":
        return [sources[n - 1]] if n and 1 <= n <= len(sources) else []
    return [next((s for s in sources if s["kind"] == "screen"), sources[0])]


def _view_tag(sources, s):
    """机位 tag：viewNum 优先，缺省退 sources 内 1 基位置——satisfies/命名/
    files_meta 三处同口径；None 不可进 satisfies（lgc 侧按 int 判等）。"""
    vn = s.get("viewNum")
    if vn is not None:
        return vn
    try:
        return sources.index(s) + 1
    except ValueError:
        return 0


# ---------- 下载与产物 ----------


def download(sess, url, dest):
    """dest.part → rename：半成品不留成正式名；异常路径 also 清掉 .part。"""
    tmp = dest.parent / (dest.name + ".part")
    req = urllib.request.Request(
        url, headers={"User-Agent": UA, "Referer": "https://v.sjtu.edu.cn/"}
    )
    try:
        with sess.follow.open(req, timeout=60) as r, open(tmp, "wb") as f:
            total = int(r.headers.get("content-length") or 0)
            done = 0
            while chunk := r.read(1 << 20):
                f.write(chunk)
                done += len(chunk)
                if total:
                    print(
                        f"\r[canvas] {dest.name}: {done * 100 // total}%",
                        end="",
                        file=sys.stderr,
                    )
        os.replace(tmp, dest)
        print(f"\r[canvas] {dest.name}: {done >> 20} MiB done", file=sys.stderr)
    finally:
        tmp.unlink(missing_ok=True)


def has_audio(path):
    r = subprocess.run(
        [
            "ffprobe",
            "-v",
            "error",
            "-show_entries",
            "stream=codec_type",
            "-of",
            "csv=p=0",
            str(path),
        ],
        capture_output=True,
        text=True,
    )
    return "audio" in r.stdout


def extract_audio(video, wav):
    subprocess.run(
        [
            "ffmpeg",
            "-y",
            "-i",
            str(video),
            "-vn",
            "-ac",
            "1",
            "-ar",
            "16000",
            "-c:a",
            "pcm_s16le",
            str(wav),
        ],
        capture_output=True,
    )


def extract_cover(video, jpg, at):
    subprocess.run(
        [
            "ffmpeg",
            "-y",
            "-ss",
            str(at),
            "-i",
            str(video),
            "-frames:v",
            "1",
            "-q:v",
            "3",
            str(jpg),
        ],
        capture_output=True,
    )


