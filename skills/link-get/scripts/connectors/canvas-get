def resolve_course_id(url):
    m = re.search(r"/courses/(\d+)", url)
    return m.group(1) if m else url.strip()


def cmd_list_courses(sess):
    courses = canvas_api(
        sess, "/courses", enrollment_state="active", per_page=100, expect=list
    )
    if courses is None:
        # None=非 200 非认证错误（404/5xx/解码失败），≠ 真空列表——不许出 '共 0 门'
        die("课程列表拉取失败（见上方 HTTP 状态行）", 5)
    for c in courses:
        name = c.get("name") or c.get("course_code") or "?"
        print(f"{c.get('id'):>8}  {name}")
    print(f"\n共 {len(courses)} 门；用课程页 URL 或 ID 作参数", file=sys.stderr)


def cmd_files(sess, course_id, download_dir=None):
    tk = tok8(sess)
    page = 1
    seen = 0
    while True:
        # --download 恒绕 api 缓存读：files[].url 是签名链，消费必须新鲜
        files = canvas_api(
            sess,
            f"/courses/{course_id}/files",
            refresh=bool(download_dir),
            per_page=100,
            page=page,
            sort="updated_at",
            order="desc",
            expect=list,
        )
        if not files:
            break
        for f in files:
            seen += 1
            size = (f.get("size") or 0) / 1024
            print(
                f"{f.get('id'):>9}  {size:8.0f}KB  "
                f"{(f.get('updated_at') or '')[:10]}  {f.get('display_name')}"
            )
            if download_dir and f.get("url"):
                dn = Path(f.get("display_name") or "").name
                if (
                    not dn
                    or dn in (".", "..")
                    or os.sep in (f.get("display_name") or "")
                ):
                    dn = f"file-{f.get('id')}"
                dest = Path(download_dir) / dn
                # file:<tok8>:<fid> 存 {size,updated_at}；dest 一致 → 跳过
                fkey = f"file:{tk}:{f.get('id')}"
                skip = False
                rc, meta = cache_cat(fkey, tk)
                if rc == 0 and dest.is_file():
                    try:
                        st = json.loads(meta)
                        skip = dest.stat().st_size == int(
                            st.get("size") or -1
                        ) and st.get("updated_at") == f.get("updated_at")
                    except (ValueError, OSError):
                        skip = False
                if skip:
                    log(f"  未变跳过 {dest.name}")
                    continue
                try:
                    download(sess, f["url"], dest)
                    cache_vput(
                        fkey,
                        json.dumps(
                            {
                                "size": dest.stat().st_size,
                                "updated_at": f.get("updated_at"),
                            }
                        ),
                        tk,
                    )
                except Exception as e:  # 单个文件失败不拖垮整批
                    log(f"  下载失败 {dest.name}: {e}")
        if len(files) < 100:
            break
        page += 1
    if not seen:
        print("（该课程未开放文件区或无文件）", file=sys.stderr)


def cmd_announcements(sess, course_id):
