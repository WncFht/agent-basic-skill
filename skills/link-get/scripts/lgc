#!/usr/bin/env python3
# lgc — link-get unified cache layer. Single-file python3-stdlib CLI.
#
# COMPAT — append-only contract (finalPlan §4.1 D). This block is the
# "compiler" for every future change; violating it breaks mixed-version fleets.
#   1. has/--version/selftest faces are permanent and zero-side-effect; cap
#      names bind v1 semantics — claiming a cap means the behavior is real.
#   2. Within PROTO 1: subcommands/flags/get rc classes (0,1,3,4,5,6,7) are
#      append-only — never removed or re-meaninged; new neg reasons reuse old
#      rc classes; entries only gains columns (never NOT NULL w/o default).
#   3. Unknown flag/subcommand → rc2 + usage hard error; unknown ns rejected
#      against the whitelist table.
#   4. get never returns an entry failing --satisfies/--require-producer;
#      unknown or missing fields → not satisfied.
#   5. Schema break → SCHEMA+1 and index renamed index-v2.sqlite3; a higher
#      on-disk user_version → refuse all writes, degrade to miss+warn (never
#      downgrade-write).
#   6. Normalization change → NORM+1; open auto-rekeys (plaintext row.key →
#      recompute kh → UPDATE → rename blob dirs; rows lacking plaintext key
#      are dropped; keep=1 always stores plaintext key).
#
# Exit codes: get 0=hit 1=miss 3=neg:notrack 4=neg:deleted
#             5=neg:unavailable/ratelimited 6=miss+claimed-inflight
#             7=miss+others'-inflight-timeout
#             put 0=stored 4=deletion-signature-refused other=cache-layer fault
#             usage errors 2 everywhere (argparse).

import argparse
